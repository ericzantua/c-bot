# Copy this file to `.env` and fill in your key. Never commit `.env`.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Text-to-speech (get a free key at elevenlabs.io) ---
ELEVENLABS_API_KEY=
# Rotate multiple ElevenLabs keys (comma-separated) — cycles to the next when one
# hits its free cap; falls back to OpenAI/browser when all are exhausted:
# ELEVENLABS_API_KEYS=key_one,key_two,key_three
# TTS_PROVIDER=elevenlabs          # or: openai | browser
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM   # for a Canadian accent, add a
#   Canadian voice from the ElevenLabs Voice Library and paste its ID here
# ELEVENLABS_MODEL=eleven_flash_v2_5
# OPENAI_API_KEY=                  # only if TTS_PROVIDER=openai

# Optional overrides (defaults shown)
# CHAT_MODEL=claude-sonnet-4-6
# VISION_MODEL=claude-sonnet-4-6
# EMBED_MODEL=all-MiniLM-L6-v2
# CHROMA_DIR=./chroma_db
# SCRAPE_DELAY_SECONDS=2
# COSTCO_BASE=https://www.costco.ca

# --- Scraper / stealth (to get past Costco bot detection) ---
# Run from a residential IP for best results. Recommended local settings:
#   HEADLESS=false          # visible browser is much harder to detect
#   CHROME_CHANNEL=chrome    # use real Google Chrome (must be installed)
#   USER_DATA_DIR=./.pw_profile   # persist cookies / anti-bot tokens
# STEALTH_MODE=true
# HEADLESS=true
# CHROME_CHANNEL=
# USER_DATA_DIR=
